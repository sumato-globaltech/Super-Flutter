#!/bin/bash

set -e

MODE="${1:-run}"

# Get Flutter devices in machine-readable format.
DEVICES=$(fvm flutter devices --machine 2>/dev/null)

if [ -z "$DEVICES" ]; then
    echo "No Flutter devices found."
    exit 1
fi

# Convert JSON → "id<TAB>name<TAB>platform"
DEVICE_LIST=$(echo "$DEVICES" | python3 -c '
import sys
import json

devices = json.load(sys.stdin)

for device in devices:
    device_id = device.get("id", "")
    name = device.get("name", device_id)
    platform = device.get("targetPlatform", "")

    if device_id:
        print(f"{device_id}\t{name}\t{platform}")
')

if [ -z "$DEVICE_LIST" ]; then
    echo "No Flutter devices found."
    exit 1
fi

# Let fzf select the device.
SELECTED=$(printf "%s\n" "$DEVICE_LIST" | \
    fzf \
    --height=50% \
    --layout=reverse \
    --border \
    --prompt="Flutter device > " \
    --header="ENTER select • ESC cancel" \
    --with-nth=2,3 \
    --delimiter=$'\t')

# User pressed ESC.
if [ -z "$SELECTED" ]; then
    echo "Device selection cancelled."
    exit 0
fi

# Extract device ID.
DEVICE_ID=$(echo "$SELECTED" | cut -f1)

echo ""
echo "Selected device:"
echo "  $SELECTED"
echo ""

case "$MODE" in

    run)
        fvm flutter run -d "$DEVICE_ID"
        ;;

    debug)
        fvm flutter run --debug -d "$DEVICE_ID"
        ;;

    profile)
        fvm flutter run --profile -d "$DEVICE_ID"
        ;;

    *)
        echo "Unknown mode: $MODE"
        exit 1
        ;;

esac
